// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

generator prisma-class-generator {
  provider                 = "prisma-class-generator"
  dryRun                   = "false"
  output                   = "dtos"
  useSwagger               = "true"
  makeIndexFile            = "true"
  separateRelationFields   = "true"
  clientImportPath         = "@prisma/client"
  useNonNullableAssertions = "false"
  preserveDefaultNullable  = "false"
}

// -------------------------------- Models ------------------------------
model User {
  id                 Int          @id @default(autoincrement())
  email              String       @unique
  password           String
  temporaryPassword  String?
  firstName          String
  lastName           String
  fullName           String
  phoneNumber        String?
  status             UserStatus   @default(Active)
  dob                DateTime?
  role               UserRole
  gender             Gender       @default(Other)
  address            String?
  city               String?
  country            String?
  imageLink          String?
  lastActive         DateTime?
  forceResetPassword Boolean      @default(false)
  language           UserLanguage @default(En)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  isDeleted          Boolean      @default(false)
}

model S3Object {
  id           Int      @id @default(autoincrement())
  userId       Int?
  eTag         String?
  location     String?
  key          String
  bucket       String
  filename     String?
  mimetype     String?
  size         Int?
  originalname String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted    Boolean  @default(false)

  PhraseAudio PhraseAudio[]
}

model AuditTrail {
  id        Int            @id @default(autoincrement())
  userId    Int
  before    Json
  after     Json?
  diffs     Json?
  type      AuditTrailType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  isDeleted Boolean        @default(false)
}

model History {
  id        Int         @id @default(autoincrement())
  userId    Int
  condition Json
  content   Json
  type      HistoryType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  isDeleted Boolean     @default(false)
}

model DataJson {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Phrase {
  id          Int        @id @default(autoincrement())
  userId      Int?
  content     String
  context     String?    @db.Text
  description String?    @db.Text
  language    Languages?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  isDeleted   Boolean    @default(false)

  PhraseAudio PhraseAudio[]
  PhraseRetry PhraseRetry[]
}

model PhraseAudio {
  id         Int      @id @default(autoincrement())
  userId     Int?
  phraseId   Int
  s3ObjectId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)

  Pharse   Phrase   @relation(fields: [phraseId], references: [id])
  S3Object S3Object @relation(fields: [s3ObjectId], references: [id])
}

model PhraseRetry {
  id        Int      @id @default(autoincrement())
  userId    Int?
  phraseId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  Phrase Phrase @relation(fields: [phraseId], references: [id])
}

model Redemption {
  id          Int              @id @default(autoincrement())
  userId      Int
  title       String
  status      RedemptionStatus @default(Pending)
  reward      String
  description String?          @db.Text
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isDeleted   Boolean          @default(false)
}

model PodRegistration {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  phone     String?
  idea      String
  details   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

// -------------------------------- Enums -------------------------------
enum UserRole {
  Admin
  Leader
  Staff
}

enum UserStatus {
  Active
  Inactive
  Closed
}

enum Gender {
  Male
  Female
  Other
}

enum Languages {
  English
  Vietnamese
  Chinese
}

enum UserLanguage {
  En
  Vn
}

enum AuditTrailType {
  Update
}

enum HistoryType {
  Update
}

enum StorageService {
  Local
  S3
}

enum RedemptionStatus {
  Pending
  Archived
  Rejected
}
